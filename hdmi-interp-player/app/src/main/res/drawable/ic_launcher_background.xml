<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层（HyperFrame）：深空底 + 左上青、右下紫两处辉光，与 App 内
  玻璃风格首页的 Hero 卡同色系（#101426 → #1B2450 → #2B1B6B / 强调色 #4C8DFF）。
  108dp 画布，中央 72dp 为安全区，外圈 18dp 会被启动器遮罩裁掉，故不放假内容。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 基底：斜向深蓝紫渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF0A0B14" />
                <item android:offset="0.55" android:color="#FF1B2450" />
                <item android:offset="1" android:color="#FF2B1B6B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上青色辉光 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="18" android:centerY="14"
                android:gradientRadius="62">
                <item android:offset="0" android:color="#4D4C8DFF" />
                <item android:offset="1" android:color="#004C8DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右下紫色辉光 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="94" android:centerY="98"
                android:gradientRadius="58">
                <item android:offset="0" android:color="#59A855F7" />
                <item android:offset="1" android:color="#00A855F7" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
